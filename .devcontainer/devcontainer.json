{
  "name": "Shiori GLOBAL - Node.js",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "index.html",
        "login.html",
        "dashboard.html"
      ]
    },
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postAttachCommand": {
    "server": "npm run dev"
  },
  "forwardPorts": [5500],
  "portsAttributes": {
    "5500": {
      "label": "Shiori GLOBAL",
      "onAutoForward": "openPreview"
    }
  }
}